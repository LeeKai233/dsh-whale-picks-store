{
  "name": "dsh-whale-picks-store",
  "version": "0.2.1",
  "description": "鲸选商店插件：DSH 设置中「Agent 预设」下方的鲸选入口——套件与插件货架、九轴 ASCII meter 柱状兑现度图、创始人评分、一键复制安装命令",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "whale-picks",
    "store",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeKai233/dsh-whale-picks-store.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "whalepicks.json",
    "README.md",
    "README.zh.md"
  ]
}
